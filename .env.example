# Create a file named .env.local in the project root and fill in your
# actual backend URL. OR run: cp .env.example .env.local
# Then edit .env.local with your real values.

# Server-side only (used by this app's own /api/* routes when they proxy a
# request to the backend from Vercel's servers) -- never exposed to the
# browser. Must include the /api path suffix.
BACKEND_API_URL=https://your-backend-domain/api

# Legacy fallback for BACKEND_API_URL, same value/format (.../api) -- only
# read when BACKEND_API_URL itself is unset. Safe to leave empty as long as
# BACKEND_API_URL above is filled in; kept only for backward compatibility
# with a couple of older routes.
BACKEND_URL=

# Bundled into the browser's own JS and used directly by the visitor's
# browser (e.g. direct file uploads, links straight to backend-served
# assets) -- bypasses the two proxy vars above entirely. No /api suffix.
NEXT_PUBLIC_BACKEND_ORIGIN=https://your-backend-domain

# Not currently read anywhere in this codebase (checked: zero references) --
# kept only in case a future browser-side call needs the full /api path
# directly. Safe to leave blank; set it to the same value as
# BACKEND_API_URL above (with the /api suffix) if you do start using it.
NEXT_PUBLIC_BACKEND_API_URL=https://your-backend-domain/api
